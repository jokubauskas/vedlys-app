// Requires the Oxc extension: `zed: extensions`, search for "Oxc".
{
  "languages": {
    "JavaScript": {
      "language_servers": ["!eslint", "..."],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "JSX": {
      "language_servers": ["!eslint", "..."],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "TypeScript": {
      "language_servers": ["!eslint", "..."],
